  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^7.0",
    "ext-ctype": "*"
  },
  "config": {
    "allow-plugins": false,
    "vendor-dir": "vendor",
    "sort-packages": true
